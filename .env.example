# Copy to .env and adjust. Consumed by both docker-compose files.

# Ollama LLM runtime. Default reaches an Ollama instance running on the host.
# For a remote/another container, set the full URL (e.g. http://192.168.1.10:11434).
OLLAMA_URL=http://host.docker.internal:11434

# Chat model name as known to Ollama.
CHAT_MODEL=gemma4:26b
